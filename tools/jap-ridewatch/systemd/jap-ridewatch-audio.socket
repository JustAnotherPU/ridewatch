# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=jap-ridewatch-audio: the RideWatch service's sound socket (Listen, Talk); its first connection starts the helper

[Socket]
# 3911's 0600: jap-ridewatch.service (uid 3911, RideWatch's own) is the one client, besides root; the helper behind it
# runs as root. Bound root's, then handed to 3911 (this systemd takes no SocketUser= for a uid without an account); if
# that fails the helper refuses to serve it. Not enabled by the install: the car test turns it on.
ListenStream=/run/jap-ridewatch/audio.sock
SocketMode=0600
DirectoryMode=0755
ExecStartPost=/bin/chown 3911:3911 /run/jap-ridewatch/audio.sock

[Install]
WantedBy=sockets.target
