{
  "id": "jap-ridewatch",
  "kind": "tool",
  "version": "0.5.5",
  "license": "GPL-3.0-or-later",
  "title": "RideWatch service",
  "description": "The RideWatch app's background service: ridewatchd.js (Node 22) fetches the H.264 stream and the event feed from your RideWatch server through a local SOCKS5 proxy (jap-wireproxy, Tailscale, ...), picks the camera that matters (rings, people, the latest detection), decodes the events' JPEG thumbnails (jpeg-js) and serves /run/jap-ridewatch/ctl.sock to the app; camdec decodes the stream with the MSDK into the mgu-render video layer (/dev/shm/mgu-video-ridewatch), as RideWatch's own uid 3911. jap-ridewatch-audio (root, for the car's SOME/IP policy, its player as 3911; socket-activated, the car's /usr/bin/node; shipped but not enabled until the car test) plays the door camera's sound on a spare audio source (Listen) and passes a lent microphone to the doorbell (Talk), and exits when idle",
  "requires": {
    "mgu-deploy": "0.7.0",
    "jap-node22": "22.23.4"
  },
  "uninstallable": true,
  "internet": true,
  "uids": [
    3911
  ],
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "camdec",
      "from": "build/camdec",
      "mode": "0755"
    },
    {
      "path": "ridewatchd.js",
      "from": "build/ridewatchd.js",
      "mode": "0644"
    },
    {
      "path": "socks.js",
      "from": "build/socks.js",
      "mode": "0644"
    },
    {
      "path": "audio/ridewatch-audio.js",
      "from": "build/audio/ridewatch-audio.js",
      "mode": "0644"
    },
    {
      "path": "audio/audio.json",
      "from": "build/audio/audio.json",
      "mode": "0644"
    },
    {
      "path": "audio/defs/org_genivi_am_commandinterface_CommandControl.json",
      "from": "build/audio/defs/org_genivi_am_commandinterface_CommandControl.json",
      "mode": "0644"
    },
    {
      "path": "audio/defs/org_genivi_am_routinginterface_RoutingControlObserver.json",
      "from": "build/audio/defs/org_genivi_am_routinginterface_RoutingControlObserver.json",
      "mode": "0644"
    },
    {
      "path": "vendor/jpeg-js/decoder.js",
      "from": "build/vendor/jpeg-js/decoder.js",
      "mode": "0644"
    },
    {
      "path": "vendor/jpeg-js/LICENSE",
      "from": "build/vendor/jpeg-js/LICENSE",
      "mode": "0644"
    },
    {
      "path": "vendor/jpeg-js/Apache-2.0.txt",
      "from": "build/vendor/jpeg-js/Apache-2.0.txt",
      "mode": "0644"
    },
    {
      "path": "check.sh",
      "from": "check.sh",
      "mode": "0755"
    },
    {
      "path": "socklock.sh",
      "from": "socklock.sh",
      "mode": "0644"
    },
    {
      "path": "LICENSE",
      "from": "build/LICENSE",
      "mode": "0644"
    },
    {
      "path": "licenses/intel-mediasdk-headers.LICENSE",
      "from": "build/licenses/intel-mediasdk-headers.LICENSE",
      "mode": "0644"
    }
  ],
  "check": [
    "check.sh"
  ],
  "units": [
    {
      "name": "jap-ridewatch.socket",
      "from": "systemd/jap-ridewatch.socket"
    },
    {
      "name": "jap-ridewatch.service",
      "from": "systemd/jap-ridewatch.service"
    },
    {
      "name": "jap-ridewatch-lock.service",
      "from": "systemd/jap-ridewatch-lock.service"
    },
    {
      "name": "jap-ridewatch-audio.socket",
      "from": "systemd/jap-ridewatch-audio.socket"
    },
    {
      "name": "jap-ridewatch-audio.service",
      "from": "systemd/jap-ridewatch-audio.service"
    }
  ],
  "enable": [
    {
      "unit": "jap-ridewatch.socket",
      "target": "sockets.target"
    },
    {
      "unit": "jap-ridewatch.service",
      "target": "multi-user.target"
    },
    {
      "unit": "jap-ridewatch-lock.service",
      "target": "multi-user.target"
    }
  ],
  "crashNames": [
    "camdec"
  ],
  "recmgr": [
    "jap-ridewatch",
    "jap-ridewatch-lock",
    "jap-ridewatch-audio"
  ],
  "restart": [
    "jap-ridewatch.service",
    "jap-ridewatch-lock.service"
  ]
}
